#!/usr/bin/env python3
"""Renders the world's seabed to a 16-bit heightmap for the caster booth's 3D map.

Needs a Subnautica install; the output is committed.

Orientation matches make-minimap: pixel (0,0) is world (-2048, -2048), +x right, +z down, so the
image is south-up (`Lms.Core.Zones.WorldMap.ImageIsSouthUp`). The renderer flips the picture, not
the transform; do not flip it here.

Elevation is big-endian in `r` and `g` because a browser canvas quantises each channel to 8 bits;
`b` flags whether the column has terrain. The encoding is written to heightmap.json, which
`scene.test.js` checks the decoder against.

usage:
    ./scripts/make-heightmap                 # writes docs/data/heightmap.{png,json}
    ./scripts/make-heightmap --size 1024     # slower, sharper
"""
import argparse
import json
import pathlib
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import lms_terrain  # noqa: E402
from lms_terrain import Terrain  # noqa: E402

REPO = pathlib.Path(__file__).resolve().parent.parent
DEFAULT_OUTPUT = REPO / "docs/data/heightmap.png"

# The band `Terrain.surface_height` scans and the 16 bits cover: islands reach above the water
# line; -1920 is below the deepest point in the game.
ELEV_TOP = 160
ELEV_BOTTOM = -1920

SAMPLE_MAX = 65535

# Blue channel: whether the column has terrain. Open water to the bottom of the scan is the void
# outside the crater, which the renderer leaves as a hole.
HAS_TERRAIN = 255
NO_TERRAIN = 0


def encode(height):
    """Elevation in metres -> the (r, g, b) pixel. None is open water outside the crater."""
    if height is None:
        return (0, 0, NO_TERRAIN)
    clamped = min(ELEV_TOP, max(ELEV_BOTTOM, height))
    sample = round((clamped - ELEV_BOTTOM) / (ELEV_TOP - ELEV_BOTTOM) * SAMPLE_MAX)
    return (sample >> 8, sample & 0xFF, HAS_TERRAIN)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--install", type=pathlib.Path,
                        default=pathlib.Path.home() / ".local/share/Steam/steamapps/common/Subnautica")
    parser.add_argument("--size", type=int, default=512, help="pixels per side")
    parser.add_argument("--step", type=int, default=4, help="metres between vertical probes")
    parser.add_argument("--output", type=pathlib.Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()

    from PIL import Image

    try:
        terrain = Terrain(args.install, cache_size=48)
    except lms_terrain.MissingTerrain as missing:
        print(f"{missing}\nThis needs a Subnautica install.", file=sys.stderr)
        return 2

    span = lms_terrain.WORLD_METRES[0]
    metres = span / args.size
    image = Image.new("RGB", (args.size, args.size))
    pixels = image.load()

    started = time.time()
    # Column-major in batch order: one file read per batch instead of one per pixel.
    order = sorted(((i, j) for i in range(args.size) for j in range(args.size)),
                   key=lambda ij: (int(ij[0] * metres) // lms_terrain.BATCH_METRES,
                                   int(ij[1] * metres) // lms_terrain.BATCH_METRES))
    empty = 0
    for i, j in order:
        x = i * metres - span / 2
        z = j * metres - span / 2
        height = terrain.surface_height(x, z, step=args.step, top=ELEV_TOP, bottom=ELEV_BOTTOM)
        if height is None:
            empty += 1
        pixels[i, j] = encode(height)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    image.save(args.output)

    meta = {
        "_comment": "Generated by scripts/make-heightmap. The renderer reads this rather than "
                    "hard-coding the encoding.",
        "size": args.size,
        "worldMetres": span,
        "metresPerPixel": metres,
        "elevTop": ELEV_TOP,
        "elevBottom": ELEV_BOTTOM,
        "sampleMax": SAMPLE_MAX,
        "encoding": "rgb8: elevation big-endian in r and g; b is 255 where the column has terrain "
                    "and 0 where the downward scan found none",
        "hasTerrain": HAS_TERRAIN,
        "verticalStepMetres": args.step,
        "imageIsSouthUp": True,
    }
    meta_path = args.output.with_suffix(".json")
    meta_path.write_text(json.dumps(meta, indent=2) + "\n")

    print(f"{args.output}  {args.size}x{args.size}, {metres:.1f} m per pixel, "
          f"{args.output.stat().st_size / 1024:.0f} KiB, "
          f"{empty} columns of open water, {time.time() - started:.0f}s")
    print(f"{meta_path}  the encoding the renderer is tested against")
    return 0


if __name__ == "__main__":
    sys.exit(main())
