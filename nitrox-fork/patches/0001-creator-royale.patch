@@ -0,0 +1,97 @@
+using System;
+using System.Collections.Generic;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Rows and buttons the mod wants in the game's options panel, rendered by the fork.
+/// </summary>
+/// <remarks>
+///     The <c>PlayerPrefs</c> key is the whole contract: Nitrox stores the value under it and the mod
+///     reads it back. Declared when the mod initialises, which is always before the panel is built.
+/// </remarks>
+public static class LmsPreferences
+{
+    private static readonly List<LmsPreference> DeclaredPreferences = new();
+    private static readonly List<LmsPreferenceButton> DeclaredButtons = new();
+
+    /// <summary>Everything the mod asked for, in the order it asked.</summary>
+    public static IReadOnlyList<LmsPreference> Preferences => DeclaredPreferences;
+
+    /// <summary>The buttons the mod asked for, in the order it asked.</summary>
+    public static IReadOnlyList<LmsPreferenceButton> Buttons => DeclaredButtons;
+
+    /// <summary>Asks for one row with a control on it.</summary>
+    public static void Declare(LmsPreference preference)
+    {
+        if (preference != null)
+        {
+            DeclaredPreferences.Add(preference);
+        }
+    }
+
+    /// <summary>Asks for one button.</summary>
+    public static void Declare(LmsPreferenceButton button)
+    {
+        if (button != null)
+        {
+            DeclaredButtons.Add(button);
+        }
+    }
+
+    /// <summary>
+    ///     Forgets everything declared so far.
+    /// </summary>
+    /// <remarks>
+    ///     Called by the mod before declaring, so a reload cannot duplicate rows.
+    /// </remarks>
+    public static void Clear()
+    {
+        DeclaredPreferences.Clear();
+        DeclaredButtons.Clear();
+    }
+}
+
+/// <summary>One row with a toggle or a slider on it.</summary>
+public sealed class LmsPreference
+{
+    /// <summary>The heading it belongs under.</summary>
+    public string Heading { get; set; } = string.Empty;
+
+    /// <summary>The <c>PlayerPrefs</c> key the value is stored under.</summary>
+    public string Key { get; set; } = string.Empty;
+
+    /// <summary>What the row says.</summary>
+    public string Label { get; set; } = string.Empty;
+
+    /// <summary>A slider when true, a toggle when false.</summary>
+    public bool IsSlider { get; set; }
+
+    /// <summary>The value before anybody has touched it. Non-zero is on, for a toggle.</summary>
+    public float Default { get; set; }
+
+    /// <summary>Slider only.</summary>
+    public float Minimum { get; set; }
+
+    /// <summary>Slider only.</summary>
+    public float Maximum { get; set; } = 1f;
+
+    /// <summary>Slider only.</summary>
+    public float Step { get; set; } = 0.05f;
+
+    /// <summary>Called with the new value when the player moves the control. Optional.</summary>
+    public Action<float>? Changed { get; set; }
+}
+
+/// <summary>One button. Pressing it is the mod's business; drawing it is the fork's.</summary>
+public sealed class LmsPreferenceButton
+{
+    /// <summary>The heading it belongs under.</summary>
+    public string Heading { get; set; } = string.Empty;
+
+    /// <summary>What the button says.</summary>
+    public string Label { get; set; } = string.Empty;
+
+    /// <summary>What to do when it is pressed.</summary>
+    public Action? Pressed { get; set; }
+}
