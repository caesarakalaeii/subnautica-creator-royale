+using Nitrox.Model.DataStructures.GameLogic;
+using Nitrox.Server.Subnautica.Models.Commands.Abstract;
+using Nitrox.Server.Subnautica.Models.Commands.Abstract.Type;
+using Nitrox.Server.Subnautica.Models.GameLogic;
+
+namespace Nitrox.Server.Subnautica.Models.Commands;
+
+/// <summary>
+///     The operator's control over the tournament match: <c>lms start</c>, <c>lms skip</c> and the rest.
+/// </summary>
+/// <remarks>
+///     Admin-only; the server console is allowed. The modifier parameter exists only so Nitrox
+///     accepts a second word (<c>lms podclear all</c>); the whole tail is passed to the mod.
+/// </remarks>
+public class LmsCommand : Command
+{
+    private readonly LmsTournament tournament;
+
+    public LmsCommand(LmsTournament tournament) : base("lms", Perms.ADMIN, "Runs the Last Man Standing tournament")
+    {
+        AddParameter(new TypeString("status/start/pause/resume/skip/reset/next/podspawn/podclear", false,
+            "What to do to the match"));
+        AddParameter(new TypeString("all", false, "Modifier: `podclear all` removes every escape pod, not only the derelicts"));
+
+        this.tournament = tournament;
+    }
+
+    protected override void Execute(CallArgs args)
+    {
+        // Bare `lms` means status. Words are passed as typed; the mod normalizes the spacing.
+        SendMessage(args.Sender, tournament.Command(args.GetTillEnd()));
+    }
+}
diff --git a/Nitrox.Server.Subnautica/Models/Commands/LmsPhantomPodsCommand.cs b/Nitrox.Server.Subnautica/Models/Commands/LmsPhantomPodsCommand.cs
new file mode 100644
index 0000000..4980abd
--- /dev/null
+++ b/Nitrox.Server.Subnautica/Models/Commands/LmsPhantomPodsCommand.cs
@@ -0,0 +1,113 @@
+using System.Collections.Generic;
+using Nitrox.Model.DataStructures;
+using Nitrox.Model.DataStructures.GameLogic;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic.Entities;
+using Nitrox.Model.Subnautica.Packets;
+using Nitrox.Server.Subnautica.Models.Commands.Abstract;
+using Nitrox.Server.Subnautica.Models.Commands.Abstract.Type;
+using Nitrox.Server.Subnautica.Models.GameLogic;
+using Nitrox.Server.Subnautica.Models.Serialization.World;
+
+namespace Nitrox.Server.Subnautica.Models.Commands;
+
+/// <summary>
+///     Test command: adds escape pods for absent players, so one machine can see how other players'
+///     pods (drawn as wrecks) look.
+/// </summary>
+/// <remarks>
+///     Pods go through <see cref="EscapePodManager.AssignPlayerToEscapePod"/> under unused player ids,
+///     the same path a real join takes. They are saved with the world, so use a scratch save.
+/// </remarks>
+public class LmsPhantomPodsCommand : Command
+{
+    /// <summary>
+    ///     First phantom player id; phantoms count down from the top because Nitrox assigns real ids
+    ///     from the bottom.
+    /// </summary>
+    private const ushort FirstPhantomId = ushort.MaxValue - 1;
+
+    /// <summary>The bottom of the phantom range, so a real player's id is never read as one.</summary>
+    private const ushort LastPhantomId = ushort.MaxValue - 1000;
+
+    /// <summary>Maximum pods one call may add.</summary>
+    private const int MostPods = 24;
+
+    private readonly PlayerManager playerManager;
+    private readonly World world;
+
+    public LmsPhantomPodsCommand(PlayerManager playerManager, World world) :
+        base("lmsphantom", Perms.ADMIN, "Adds escape pods for players who are not there, for testing a pod each on one machine")
+    {
+        AddParameter(new TypeInt("pods", false, "How many pods to add"));
+
+        this.playerManager = playerManager;
+        this.world = world;
+    }
+
+    /// <summary>
+    ///     The next unused phantom id, read from the players already in the pods so repeated calls
+    ///     never reuse one.
+    /// </summary>
+    private static ushort NextPhantomId(List<EscapePodEntity> pods)
+    {
+        ushort next = FirstPhantomId;
+
+        foreach (EscapePodEntity pod in pods)
+        {
+            foreach (ushort player in pod.Players)
+            {
+                if (player >= LastPhantomId && player <= next)
+                {
+                    next = (ushort)(player - 1);
+                }
+            }
+        }
+
+        return next;
+    }
+
+    protected override void Execute(CallArgs args)
+    {
+        List<EscapePodEntity> before = world.EntityRegistry.GetEntities<EscapePodEntity>();
+
+        int wanted = args.Get<int>(0);
+        if (wanted <= 0)
+        {
+            SendMessage(args.Sender, $"The world has {before.Count} escape pod(s). `lmsphantom 4` adds four more.");
+            return;
+        }
+
+        if (wanted > MostPods)
+        {
+            SendMessage(args.Sender, $"{wanted} is more pods than a tournament has players; {MostPods} is the most this will make.");
+            return;
+        }
+
+        ushort phantom = NextPhantomId(before);
+        int added = 0;
+
+        for (int pod = 0; pod < wanted; pod++, phantom--)
+        {
+            world.EscapePodManager.AssignPlayerToEscapePod(phantom, out Optional<EscapePodEntity> created);
+
+            if (!created.HasValue)
+            {
+                // An existing pod with room took the phantom (the stock behavior without a
+                // tournament), so there is nothing to broadcast.
+                SendMessage(args.Sender, added == 0
+                    ? $"A pod the world already has took the phantom instead of a new one being made, so "
+                      + $"nothing was added. Either spawn.ownPod is off, or that pod predates this world "
+                      + $"having a tournament -- {before.Count} pod(s) were here before this command."
+                    : $"Added {added} pod(s); the next phantom shared one instead of making another.");
+                return;
+            }
+
+            playerManager.SendPacketToAllPlayers(new SpawnEntities(created.Value));
+            added++;
+        }
+
+        List<EscapePodEntity> now = world.EntityRegistry.GetEntities<EscapePodEntity>();
+        SendMessage(args.Sender, $"Added {added} phantom pod(s); the world has {now.Count}. " +
+                                 "Each is somebody else's as far as a client is concerned, so it should draw as a wreck.");
+    }
+}
