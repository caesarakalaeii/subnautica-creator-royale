diff --git a/NitroxPatcher/LmsHook.cs b/NitroxPatcher/LmsHook.cs
new file mode 100644
index 0000000..bc2fb00
--- /dev/null
+++ b/NitroxPatcher/LmsHook.cs
@@ -0,0 +1,133 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using Nitrox.Model.Core;
+using NitroxClient.Communication.Abstract;
+using NitroxClient.Communication.NetworkingLayer.LiteNetLib;
+using Nitrox.Model.Subnautica.Packets;
+using Nitrox.Model.Subnautica.Tournament;
+
+namespace NitroxPatcher;
+
+/// <summary>
+///     Calls into the tournament mod once Nitrox is initialized.
+/// </summary>
+/// <remarks>
+///     The mod (<c>Lms.Game</c>) is loaded by name rather than referenced, so the fork builds and runs
+///     as stock Nitrox when the mod is not deployed.
+/// </remarks>
+internal static class LmsHook
+{
+    private const string ModAssemblyName = "Lms.Game";
+    private const string EntryTypeName = "Lms.Game.LmsMod";
+    private const string EntryMethodName = "Initialize";
+
+    internal static void Initialize()
+    {
+        List<string> searched = new List<string>();
+        string modAssemblyPath = null;
+
+        foreach (string directory in ProbeDirectories())
+        {
+            string candidate = Path.Combine(directory, ModAssemblyName + ".dll");
+            searched.Add(candidate);
+            if (File.Exists(candidate))
+            {
+                modAssemblyPath = candidate;
+                break;
+            }
+        }
+
+        if (modAssemblyPath == null)
+        {
+            // Name every path tried, so nobody deploys the mod to the wrong one.
+            Log.Info($"[LMS] {ModAssemblyName}.dll not found; running as stock Nitrox. Looked in: {string.Join(", ", searched)}");
+            return;
+        }
+
+        try
+        {
+            Assembly modAssembly = Assembly.LoadFrom(modAssemblyPath);
+            Type entryType = modAssembly.GetType(EntryTypeName, true);
+            MethodInfo entryMethod = entryType.GetMethod(EntryMethodName, BindingFlags.Public | BindingFlags.Static);
+            if (entryMethod == null)
+            {
+                throw new MissingMethodException(EntryTypeName, EntryMethodName);
+            }
+
+            // Before the handover, so a mod that reports immediately has somewhere to report to.
+            LmsReporting.Send = Report;
+
+            // The reverse direction: the mod asks and this answers.
+            LmsNetwork.Ping = ReadPing;
+
+            Log.Info($"[LMS] Handing over to {EntryTypeName}.{EntryMethodName} from '{modAssemblyPath}'");
+            entryMethod.Invoke(null, null);
+        }
+        catch (Exception ex)
+        {
+            // A failing mod must not take Nitrox with it; fall back to plain multiplayer.
+            Log.Error(ex, "[LMS] Failed to initialize the tournament mod; continuing without it.");
+        }
+    }
+
+    /// <summary>
+    ///     Sends one of the mod's reports about the local player to the server.
+    /// </summary>
+    /// <remarks>
+    ///     Lives here because the mod does not reference <c>NitroxClient</c>. The sender is resolved
+    ///     per send since the session scope is absent in the main menu and replaced on rejoin;
+    ///     failures are logged once and dropped.
+    /// </remarks>
+    private static void Report(string report)
+    {
+        try
+        {
+            NitroxServiceLocator.LocateService<IPacketSender>().Send(new LmsPlayerReport(report));
+        }
+        catch (Exception ex)
+        {
+            Log.WarnOnce($"[LMS] Could not send a player report: {ex.Message}");
+        }
+    }
+
+    /// <summary>
+    ///     The round trip to the server in milliseconds, or -1 when nothing can say.
+    /// </summary>
+    /// <remarks>
+    ///     Resolved per read, like <see cref="Report"/>. Returns -1 rather than 0 on failure because
+    ///     zero is a real reading on a listen server.
+    /// </remarks>
+    private static int ReadPing()
+    {
+        try
+        {
+            return NitroxServiceLocator.LocateService<IClient>() is LiteNetLibClient client
+                ? client.Ping
+                : -1;
+        }
+        catch (Exception)
+        {
+            // No session scope yet (main menu); not worth a log line every frame.
+            return -1;
+        }
+    }
+
+    /// <summary>
+    ///     Where the mod might be, best candidate first.
+    /// </summary>
+    private static IEnumerable<string> ProbeDirectories()
+    {
+        // Beside Nitrox's own assemblies in the launcher's lib/net472, where the mod is installed.
+        // Main.cs has already put the launcher path in the environment by now.
+        string launcherDirectory = Environment.GetEnvironmentVariable(NitroxUser.LAUNCHER_PATH_ENV_KEY, EnvironmentVariableTarget.Process);
+        if (!string.IsNullOrEmpty(launcherDirectory))
+        {
+            yield return Path.Combine(launcherDirectory, "lib", "net472");
+        }
+
+        // Beside this assembly, which is the game's Managed directory, not the Nitrox folder.
+        yield return Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location) ?? string.Empty;
+    }
+}
diff --git a/NitroxPatcher/LmsSettings.cs b/NitroxPatcher/LmsSettings.cs
new file mode 100644
index 0000000..e8c38da
--- /dev/null
+++ b/NitroxPatcher/LmsSettings.cs
@@ -0,0 +1,103 @@
+using System;
+using System.Collections.Generic;
+using Nitrox.Model.Logger;
+using Nitrox.Model.Subnautica.Tournament;
+using NitroxClient.GameLogic.Settings;
+using UnityEngine.Events;
+
+namespace NitroxPatcher;
+
+/// <summary>
+///     Turns the tournament mod's declared <see cref="LmsPreferences"/> into options panel rows.
+/// </summary>
+/// <remarks>
+///     Lives here because the mod does not reference <c>NitroxClient</c>. The panel is rebuilt on
+///     every open but the manager outlives it, so each row is added only once.
+/// </remarks>
+internal static class LmsSettings
+{
+    internal static void Register(NitroxSettingsManager settings)
+    {
+        if (settings == null || (LmsPreferences.Preferences.Count == 0 && LmsPreferences.Buttons.Count == 0))
+        {
+            return;
+        }
+
+        try
+        {
+            foreach (LmsPreference preference in LmsPreferences.Preferences)
+            {
+                if (AlreadyAdded(settings, preference.Heading, preference.Label))
+                {
+                    continue;
+                }
+
+                settings.AddSetting(preference.Heading, Row(preference));
+            }
+
+            foreach (LmsPreferenceButton button in LmsPreferences.Buttons)
+            {
+                if (AlreadyAdded(settings, button.Heading, button.Label))
+                {
+                    continue;
+                }
+
+                Action pressed = button.Pressed ?? (() => { });
+                settings.AddSetting(button.Heading,
+                    new NitroxSettingsManager.Setting(button.Label, new UnityAction(pressed)));
+            }
+        }
+        catch (Exception ex)
+        {
+            // A broken tournament row must not break the rest of the options panel.
+            Log.Error(ex, "[LMS] Could not add the tournament's settings; the rest of the panel is unaffected.");
+        }
+    }
+
+    /// <summary>
+    ///     Builds a slider or toggle row. Like Nitrox's own settings, the callback writes the pref
+    ///     itself, then notifies the mod via <c>Changed</c>.
+    /// </summary>
+    private static NitroxSettingsManager.Setting Row(LmsPreference preference)
+    {
+        if (preference.IsSlider)
+        {
+            NitroxPref<float> pref = new(preference.Key, preference.Default);
+            Action<float> changed = preference.Changed ?? (_ => { });
+
+            return new NitroxSettingsManager.Setting(preference.Label, pref, new UnityAction<float>(value =>
+            {
+                pref.Value = value;
+                changed(value);
+            }), preference.Minimum, preference.Maximum, preference.Default, preference.Step,
+                SliderLabelMode.Float, "0.00");
+        }
+
+        NitroxPref<bool> toggle = new(preference.Key, preference.Default != 0f);
+        Action<float> toggled = preference.Changed ?? (_ => { });
+
+        return new NitroxSettingsManager.Setting(preference.Label, toggle, new UnityAction<bool>(value =>
+        {
+            toggle.Value = value;
+            toggled(value ? 1f : 0f);
+        }));
+    }
+
+    private static bool AlreadyAdded(NitroxSettingsManager settings, string heading, string label)
+    {
+        if (!settings.NitroxSettings.TryGetValue(heading, out List<NitroxSettingsManager.Setting> rows))
+        {
+            return false;
+        }
+
+        foreach (NitroxSettingsManager.Setting row in rows)
+        {
+            if (string.Equals(row.Label, label, StringComparison.Ordinal))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
