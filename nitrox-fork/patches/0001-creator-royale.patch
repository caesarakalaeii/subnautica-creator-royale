diff --git a/Nitrox.Test/Model/Networking/PacketFrameTest.cs b/Nitrox.Test/Model/Networking/PacketFrameTest.cs
new file mode 100644
index 0000000..85520c3
--- /dev/null
+++ b/Nitrox.Test/Model/Networking/PacketFrameTest.cs
@@ -0,0 +1,80 @@
+using LiteNetLib.Utils;
+using Nitrox.Model.DataStructures;
+using Nitrox.Model.DataStructures.Unity;
+using Nitrox.Model.Packets;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic.Entities;
+using Nitrox.Model.Subnautica.Packets;
+
+namespace Nitrox.Model.Networking;
+
+[TestClass]
+public class PacketFrameTest
+{
+    [ClassInitialize]
+    public static void InitSerializer(TestContext _) => Packet.InitSerializer();
+
+    [TestMethod]
+    public void A_packet_that_fits_a_datagram_is_framed_exactly_as_before()
+    {
+        ChatMessage packet = new(7, "hello");
+        byte[] plain = packet.Serialize();
+
+        NetDataReader reader = new(Frame(packet));
+
+        reader.GetInt().Should().Be(plain.Length);
+        reader.GetRemainingBytes().Should().Equal(plain);
+    }
+
+    [TestMethod]
+    public void A_small_packet_reads_back_as_itself()
+    {
+        ChatMessage packet = new(7, "hello");
+
+        Packet back = PacketFrame.Read(new NetDataReader(Frame(packet)));
+
+        back.Should().BeOfType<ChatMessage>().Which.Text.Should().Be("hello");
+    }
+
+    [TestMethod]
+    public void A_cell_reply_goes_out_deflated()
+    {
+        SpawnEntities packet = CellReply(500);
+
+        Frame(packet).Length.Should().BeLessThan(packet.Serialize().Length / 2);
+    }
+
+    [TestMethod]
+    public void A_deflated_cell_reply_reads_back_as_the_same_packet()
+    {
+        SpawnEntities packet = CellReply(500);
+
+        Packet back = PacketFrame.Read(new NetDataReader(Frame(packet)));
+
+        back.Serialize().Should().Equal(packet.Serialize());
+    }
+
+    private static byte[] Frame(Packet packet)
+    {
+        NetDataWriter writer = new();
+        PacketFrame.Write(writer, packet);
+        return writer.CopyData();
+    }
+
+    /// <summary>What a join is answered with: many entities that share a handful of class ids.</summary>
+    private static SpawnEntities CellReply(int count)
+    {
+        Random random = new(1);
+        AbsoluteEntityCell cell = new(new NitroxInt3(11, 18, 13), new NitroxInt3(0, 9, 7), 0);
+        List<Entity> entities = [];
+        for (int i = 0; i < count; i++)
+        {
+            NitroxVector3 at = new((float)random.NextDouble() * 160, (float)random.NextDouble() * -40, (float)random.NextDouble() * 160);
+            entities.Add(new WorldEntity(at, NitroxQuaternion.Identity, NitroxVector3.One, NitroxTechType.None, 0,
+                                         i % 3 == 0 ? "a17ef178-6952-4a91-8f66-44e1d3ca0575" : "154a88e1-1c61-4f6b-a6b8-7a3e8f8f0a3e",
+                                         true, new NitroxId(), null));
+        }
+
+        return new SpawnEntities(entities, [cell], true);
+    }
+}
