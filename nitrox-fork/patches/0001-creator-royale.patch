+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     One player as the server sees them, for the caster view.
+/// </summary>
+/// <remarks>
+///     Flat primitives so it crosses the load-by-name boundary into the mod's <c>netstandard2.0</c>
+///     Core without either side referencing the other.
+/// </remarks>
+public readonly struct LmsPlayerReading
+{
+    public LmsPlayerReading(ushort id, string name, bool alive, float x, float y, float z,
+        float health, float oxygen, float food, float water)
+    {
+        Id = id;
+        Name = name;
+        Alive = alive;
+        X = x;
+        Y = y;
+        Z = z;
+        Health = health;
+        Oxygen = oxygen;
+        Food = food;
+        Water = water;
+    }
+
+    /// <summary>Nitrox's own id for this player, which is what anything about them is keyed on.</summary>
+    public ushort Id { get; }
+
+    public string Name { get; }
+
+    /// <summary>
+    ///     Whether the server believes this player is still in the world.
+    /// </summary>
+    /// <remarks>
+    ///     Nitrox's hardcore permadeath, not tournament elimination, which is decided on the client.
+    /// </remarks>
+    public bool Alive { get; }
+
+    public float X { get; }
+
+    public float Y { get; }
+
+    public float Z { get; }
+
+    public float Health { get; }
+
+    public float Oxygen { get; }
+
+    public float Food { get; }
+
+    public float Water { get; }
+}
