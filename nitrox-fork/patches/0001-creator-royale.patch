diff --git a/Nitrox.Model.Subnautica/Packets/LmsMatchState.cs b/Nitrox.Model.Subnautica/Packets/LmsMatchState.cs
new file mode 100644
index 0000000..d61fd69
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Packets/LmsMatchState.cs
@@ -0,0 +1,24 @@
+using System;
+using Nitrox.Model.Packets;
+
+namespace Nitrox.Model.Subnautica.Packets;
+
+/// <summary>
+///     Server-to-client tournament zone state: the match phase, where the wall is, where it is
+///     closing to and what a tick outside costs.
+/// </summary>
+/// <remarks>
+///     Sent on every change and on a slow heartbeat. The payload is tab-separated <c>key=value</c>
+///     text whose fields belong to the mod, because the mod's assembly cannot be referenced from here.
+///     An empty payload means no tournament is running.
+/// </remarks>
+[Serializable]
+public class LmsMatchState : Packet
+{
+    public string State { get; }
+
+    public LmsMatchState(string state)
+    {
+        State = state;
+    }
+}
diff --git a/Nitrox.Model.Subnautica/Packets/LmsPlayerReport.cs b/Nitrox.Model.Subnautica/Packets/LmsPlayerReport.cs
