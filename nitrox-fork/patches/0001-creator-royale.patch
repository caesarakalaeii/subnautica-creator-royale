@@ -0,0 +1,24 @@
+using System.Collections.Generic;
+using Nitrox.Model.DataStructures.Unity;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Where the tournament wants players to start, overriding Nitrox's shared-pod placement.
+/// </summary>
+/// <remarks>
+///     Candidates still come from the game's own start-point map via <c>RandomStartGenerator</c>,
+///     so the mod only picks between points the game already approves.
+/// </remarks>
+public interface ILmsSpawnPlacement
+{
+    /// <summary>How many players share one escape pod.</summary>
+    int PlayersPerPod { get; }
+
+    /// <summary>
+    ///     Where the next pod goes, or null to leave the placement to Nitrox.
+    /// </summary>
+    /// <param name="candidates">Valid start points from the game's own map.</param>
+    /// <param name="taken">Where the pods already placed are.</param>
+    NitroxVector3? NextPod(IReadOnlyList<NitroxVector3> candidates, IReadOnlyList<NitroxVector3> taken);
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/ILmsTournamentHost.cs b/Nitrox.Model.Subnautica/Tournament/ILmsTournamentHost.cs
new file mode 100644
index 0000000..c149c89
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/ILmsTournamentHost.cs
@@ -0,0 +1,23 @@
+using System;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     The tournament, as the server sees it.
+/// </summary>
+/// <remarks>
+///     Implemented by the mod's <c>Lms.Server.dll</c>, loaded by name at startup; without it the
+///     server is stock Nitrox. Calls take the server's world time because clients read the same
+///     clock through <c>DayNightCycle</c> and compute the wall between broadcasts.
+/// </remarks>
+public interface ILmsTournamentHost
+{
+    /// <summary>Drives the match to a moment on the world clock and sends whatever changed.</summary>
+    void Tick(TimeSpan worldNow);
+
+    /// <summary>Runs one <c>lms</c> verb and returns the line to say back to whoever typed it.</summary>
+    string Command(string? verb, TimeSpan worldNow);
+
+    /// <summary>Sends the zone to one player, who has just finished syncing and knows nothing.</summary>
+    void Greet(ushort playerId, TimeSpan worldNow);
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/LmsCombat.cs b/Nitrox.Model.Subnautica/Tournament/LmsCombat.cs
new file mode 100644
index 0000000..80f51a9
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/LmsCombat.cs
@@ -0,0 +1,23 @@
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Says that a tournament is loaded, so player-versus-player damage is the tournament's and
+///     Nitrox's own PvP path must stand down.
+/// </summary>
+/// <remarks>
+///     Otherwise a hit is paid twice, once by Nitrox's <c>PvPAttack</c> relay and once by the mod.
+///     <c>PvPEnabled</c> in server.cfg cannot be used: the <c>pvp</c> command, the launcher and every
+///     command that calls <c>serverConfig.Update(...)</c> re-read it from disk.
+///     <para>
+///     Set while the tournament is loaded, regardless of whether its rules allow blade damage. False
+///     is stock Nitrox.
+///     </para>
+/// </remarks>
+public static class LmsCombat
+{
+    /// <summary>
+    ///     Set when a tournament starts and cleared when it stops, but not when its host dies
+    ///     mid-session. Read by <c>PvPAttackProcessor</c> and the <c>pvp</c> command.
+    /// </summary>
+    public static bool TournamentOwnsPvP { get; set; }
+}
