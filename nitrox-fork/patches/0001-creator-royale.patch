--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/LmsPodWrecks.cs
@@ -0,0 +1,57 @@
+using System;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     The wrecked lifepod prefabs other players' escape pods are drawn as.
+/// </summary>
+/// <remarks>
+///     Nitrox's <c>EscapePodEntitySpawner</c> reuses the single <c>EscapePod.main</c>, so only a
+///     player's own pod is real and everyone else's is scenery. These prefabs have renderers and no
+///     <c>EscapePod</c> component, so they can never become <c>EscapePod.main</c>; the
+///     <c>EscapePod_*</c> slot prefabs have no renderers.
+/// </remarks>
+public static class LmsPodWrecks
+{
+    /// <summary>
+    ///     The nine, in the game's own numbering. Order decides which pod gets which wreck and must
+    ///     match on every client.
+    /// </summary>
+    private static readonly string[] ClassIds =
+    {
+        "66cc5a83-142b-4d8d-8d16-2d6e960f59c3", // life_pod_exploded_2
+        "2aa237f6-2103-4a78-aaa7-104216551f0a", // life_pod_exploded_3
+        "f2b9fe45-39d6-4307-b1e0-143eb1937d6e", // life_pod_exploded_4
+        "85ae70e0-176c-4de6-8c4d-48c4f504cc79", // life_pod_exploded_6
+        "d3b9095f-fcac-46de-83f7-762e3275e837", // life_pod_exploded_7
+        "00891fdf-7264-4c55-b569-732cdcded701", // life_pod_exploded_12
+        "00037e80-3037-48cf-b769-dc97c761e5f6", // life_pod_exploded_13
+        "56b5ed17-2bff-4f7e-aba0-275b6a2398f9", // life_pod_exploded_17
+        "3894aeaf-e1f9-426a-9249-6a4968ac2d8b"  // life_pod_exploded_19
+    };
+
+    /// <summary>How many different wrecks there are, which is how many pods look distinct.</summary>
+    public static int Count => ClassIds.Length;
+
+    /// <summary>
+    ///     Which wreck stands in for a given pod; every client derives the same answer from the pod id.
+    /// </summary>
+    /// <remarks>
+    ///     Summed characters rather than <c>GetHashCode</c>, which is randomised per process.
+    /// </remarks>
+    public static string For(string podId)
+    {
+        if (string.IsNullOrEmpty(podId))
+        {
+            return ClassIds[0];
+        }
+
+        int total = 0;
+        foreach (char character in podId)
+        {
+            total = (total + character) % ClassIds.Length;
+        }
+
+        return ClassIds[total];
+    }
+}
