@@ -0,0 +1,24 @@
+using System;
+using Nitrox.Model.Packets;
+
+namespace Nitrox.Model.Subnautica.Packets;
+
+/// <summary>
+///     Client-to-server tournament report: the player's biome, vehicle, held item, inventory and
+///     whether the match is finished with them.
+/// </summary>
+/// <remarks>
+///     Carries no sender: the processor stamps it from the authenticated connection, so a client can
+///     only report on itself. The payload is tab-separated <c>key=value</c> text, as in
+///     <see cref="LmsMatchState"/>.
+/// </remarks>
+[Serializable]
+public class LmsPlayerReport : Packet
+{
+    public string Report { get; }
+
+    public LmsPlayerReport(string report)
+    {
+        Report = report;
+    }
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/ILmsGameMode.cs b/Nitrox.Model.Subnautica/Tournament/ILmsGameMode.cs
new file mode 100644
index 0000000..b8b8754
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/ILmsGameMode.cs
@@ -0,0 +1,33 @@
+using System.Collections.Generic;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Lets the mod read and correct the game mode the server holds for each player.
+/// </summary>
+/// <remarks>
+///     Nitrox persists a game mode per player and prefers it over <c>server.cfg</c>, so a returning
+///     player can stay in creative, which ignores zone damage. Read off <c>PlayerManager</c>, never
+///     the client. Policy lives in the mod.
+/// </remarks>
+public interface ILmsGameMode
+{
+    /// <summary>
+    ///     Every connected player and the mode the server holds for them.
+    /// </summary>
+    /// <remarks>
+    ///     All connected players, not just contestants: only the mod knows who is a spectator.
+    /// </remarks>
+    IReadOnlyList<LmsPlayerMode> Modes { get; }
+
+    /// <summary>
+    ///     Puts one player into survival and tells every client, exactly as Nitrox's own
+    ///     <c>gamemode</c> command does.
+    /// </summary>
+    /// <remarks>
+    ///     Survival only, so no caller can put a player into creative by accident. The
+    ///     <c>GameModeChanged</c> broadcast is what makes the player mortal on their client.
+    /// </remarks>
+    /// <returns>False when there is no connected player with that id.</returns>
+    bool MakeSurvival(ushort playerId);
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/ILmsPodSeating.cs b/Nitrox.Model.Subnautica/Tournament/ILmsPodSeating.cs
new file mode 100644
index 0000000..bf11ec6
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/ILmsPodSeating.cs
@@ -0,0 +1,60 @@
+using System.Collections.Generic;
+using Nitrox.Model.DataStructures.Unity;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Server-side escape pod operations the mod asks for: list, make, seat and remove.
+/// </summary>
+/// <remarks>
+///     Nitrox assigns a pod only once, on join, so laying a group out again needs the server. Which
+///     player goes where is decided in the mod; nothing here decides anything.
+/// </remarks>
+public interface ILmsPodSeating
+{
+    /// <summary>
+    ///     Every escape pod in the world: where it is, who is assigned to it, and what is in it.
+    /// </summary>
+    IReadOnlyList<LmsPod> Pods { get; }
+
+    /// <summary>
+    ///     The start points the game itself approves of, for a layout that picks between them.
+    /// </summary>
+    /// <remarks>
+    ///     The same list <see cref="ILmsSpawnPlacement.NextPod"/> is handed on a join, available here
+    ///     so a whole group can be re-planned at once.
+    /// </remarks>
+    IReadOnlyList<NitroxVector3> StartPoints { get; }
+
+    /// <summary>
+    ///     Makes an escape pod at this exact position, gives it to <paramref name="ownerId"/>, and
+    ///     tells every client about it. Returns the new pod's <see cref="LmsPod.Id"/>, or null if declined.
+    /// </summary>
+    /// <remarks>
+    ///     The owner must be set before the broadcast: <c>EscapePodEntitySpawner.IsOurs</c> treats a
+    ///     pod with no players as the joining client's own, so every client would move its pod onto it.
+    ///     <para>
+    ///     This does not move the player; call <see cref="Seat"/> after every pod is made, because a
+    ///     teleport while a client is still moving its own pod re-parents the player into nothing.
+    ///     </para>
+    /// </remarks>
+    string? MakePod(NitroxVector3 where, ushort ownerId);
+
+    /// <summary>
+    ///     Puts a player in the escape pod with this <see cref="LmsPod.Id"/> and moves them into it.
+    /// </summary>
+    /// <remarks>
+    ///     By id rather than position, since two pods can share a spot. False when the pod or the
+    ///     player is gone, which is ordinary.
+    /// </remarks>
+    bool Seat(ushort playerId, string podId);
+
+    /// <summary>
+    ///     Takes an escape pod out of the world and tells every client to stop drawing it.
+    /// </summary>
+    /// <remarks>
+    ///     By id rather than position, so two nearby pods are never confused. False when no pod has
+    ///     that id any more. Whether a pod may be removed is decided by the mod.
+    /// </remarks>
+    bool RemovePod(string id);
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/ILmsSpawnPlacement.cs b/Nitrox.Model.Subnautica/Tournament/ILmsSpawnPlacement.cs
new file mode 100644
