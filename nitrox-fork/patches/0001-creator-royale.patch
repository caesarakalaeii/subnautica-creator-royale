@@ -0,0 +1,20 @@
+using Nitrox.Model.DataStructures.GameLogic;
+using Nitrox.Model.Subnautica.Packets;
+using Nitrox.Model.Subnautica.Tournament;
+using Nitrox.Server.Subnautica.Models.Packets.Processors.Core;
+
+namespace Nitrox.Server.Subnautica.Models.Packets.Processors;
+
+/// <summary>
+///     Hands a tournament client's report about itself to the mod via <see cref="LmsPlayerReportRelay"/>.
+///     Server-only; not forwarded to other players.
+/// </summary>
+public class LmsPlayerReportProcessor : AuthenticatedPacketProcessor<LmsPlayerReport>
+{
+    public override void Process(LmsPlayerReport packet, Player player)
+    {
+        // Identity and admin permission come from the server, never the packet: some reports ask
+        // to change the match.
+        LmsPlayerReportRelay.Publish(player.Id, player.Permissions >= Perms.ADMIN, packet.Report);
+    }
+}
