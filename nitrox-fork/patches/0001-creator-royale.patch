@@ -0,0 +1,373 @@
+using System.Collections.Generic;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic;
+using UnityEngine;
+
+namespace NitroxClient.GameLogic;
+
+/// <summary>
+/// Diagnostic that times the entity round trip per cell: request sent, server reply, fully spawned.
+/// </summary>
+/// <remarks>
+/// Also counts the two failures: a cell unloaded before its reply, and a cell never answered. Requests
+/// and replies pair exactly by <see cref="AbsoluteEntityCell"/>, since several cells are in flight at
+/// once at speed. Off unless <c>NITROX_LMS_CELL_TIMING</c> is set or the marker file exists.
+/// </remarks>
+public static class CellTiming
+{
+    /// <summary>How long a cell may go unanswered before it is counted as never answered.</summary>
+    /// <remarks>
+    /// Deliberately far past anything playable: a level-0 cell takes about 5 s to cross swimming,
+    /// 1.4 s on a Seaglide.
+    /// </remarks>
+    private const float GiveUpAfterSeconds = 10f;
+
+    /// <summary>How often the summary line is written, alongside the per-cell lines.</summary>
+    private const float SummaryEverySeconds = 15f;
+
+    private static readonly Dictionary<AbsoluteEntityCell, Sample> InFlight = [];
+
+    /// <summary>
+    /// Send time of each cell given up on, so a reply that still arrives counts as late, not lost.
+    /// </summary>
+    private static readonly Dictionary<AbsoluteEntityCell, float> GaveUpOn = [];
+
+    private static bool? enabled;
+    private static float lastSummaryAt;
+    private static Vector3 wasAt;
+    private static float speed;
+
+    // Totals since the last summary.
+    private static int replied;
+    private static float replyTotal;
+    private static float replyWorst;
+    private static int spawned;
+    private static float spawnTotal;
+    private static float spawnWorst;
+    private static int unloadedFirst;
+    private static int neverAnswered;
+    private static int late;
+    private static float lateWorst;
+
+    /// <summary>The file that turns this on, beside this assembly. See <see cref="Enabled"/>.</summary>
+    private const string MarkerFile = "lms-cell-timing";
+
+    /// <summary>
+    /// Whether timing is on. Decided once per session.
+    /// </summary>
+    /// <remarks>
+    /// The environment variable does not reach a game started by Steam, so a marker file beside
+    /// NitroxClient (the launcher's <c>lib/net472</c>) also turns it on; see <see cref="Places"/>.
+    /// </remarks>
+    public static bool Enabled
+    {
+        get
+        {
+            if (enabled.HasValue)
+            {
+                return enabled.Value;
+            }
+
+            string why = Decide();
+            enabled = why != null;
+
+            // Log either way, so "off" is never mistaken for "broken", and say where it looked.
+            if (enabled.Value)
+            {
+                Log.Info($"[LMS] cell timing ON ({why}). A line per cell and a summary every " +
+                         $"{SummaryEverySeconds:0}s.");
+            }
+            else
+            {
+                Log.Info($"[LMS] cell timing off. Set NITROX_LMS_CELL_TIMING, or touch " +
+                         $"'{MarkerFile}' in one of: {string.Join(", ", Places())}");
+            }
+
+            return enabled.Value;
+        }
+    }
+
+    /// <summary>
+    /// Directories checked for the marker file: beside NitroxClient (the launcher's <c>lib/net472</c>),
+    /// then the game's base directory.
+    /// </summary>
+    private static IEnumerable<string> Places()
+    {
+        string beside = null;
+
+        try
+        {
+            beside = System.IO.Path.GetDirectoryName(
+                System.Reflection.Assembly.GetExecutingAssembly().Location);
+        }
+        catch (System.Exception)
+        {
+            // A dynamic assembly has no location; fall through to the other place.
+        }
+
+        if (!string.IsNullOrEmpty(beside))
+        {
+            yield return beside;
+        }
+
+        string game = System.AppDomain.CurrentDomain.BaseDirectory;
+        if (!string.IsNullOrEmpty(game) && game != beside)
+        {
+            yield return game;
+        }
+    }
+
+    /// <summary>Why it is on, or null. The reason is what goes in the log.</summary>
+    private static string Decide()
+    {
+        if (!string.IsNullOrEmpty(
+                System.Environment.GetEnvironmentVariable("NITROX_LMS_CELL_TIMING")))
+        {
+            return "NITROX_LMS_CELL_TIMING";
+        }
+
+        foreach (string place in Places())
+        {
+            try
+            {
+                if (System.IO.File.Exists(System.IO.Path.Combine(place, MarkerFile)))
+                {
+                    return System.IO.Path.Combine(place, MarkerFile);
+                }
+            }
+            catch (System.Exception)
+            {
+                // An unreadable directory is not worth crashing a diagnostic.
+            }
+        }
+
+        return null;
+    }
+
+    /// <summary>A cell has just gone out on a <c>CellVisibilityChanged</c>.</summary>
+    /// <remarks>
+    /// Stamped at send, not at <c>CellLoaded</c>, so the 50 ms batching window is inside the measurement.
+    /// </remarks>
+    public static void Sent(AbsoluteEntityCell cell)
+    {
+        if (!Enabled)
+        {
+            return;
+        }
+
+        // Overwrite: a cell reloaded within one reply's lifetime is waiting on the newer request.
+        InFlight[cell] = new Sample(Time.realtimeSinceStartup, speed);
+        GaveUpOn.Remove(cell);
+    }
+
+    /// <summary>The server's answer has arrived for this cell, before anything is spawned.</summary>
+    /// <remarks>
+    /// The gap between this and <see cref="Spawned"/> is the client's own spawn queue.
+    /// </remarks>
+    public static void Replied(AbsoluteEntityCell cell)
+    {
+        if (!Enabled)
+        {
+            return;
+        }
+
+        if (GaveUpOn.TryGetValue(cell, out float sentAt))
+        {
+            GaveUpOn.Remove(cell);
+            float after = Time.realtimeSinceStartup - sentAt;
+
+            late++;
+            lateWorst = Mathf.Max(lateWorst, after);
+
+            Log.Warn($"[LMS] LATE reply cell={Describe(cell)} in={after * 1000f:0} ms");
+            return;
+        }
+
+        if (!InFlight.TryGetValue(cell, out Sample sample) || sample.RepliedAt > 0f)
+        {
+            return;
+        }
+
+        float now = Time.realtimeSinceStartup;
+        float delta = now - sample.SentAt;
+
+        InFlight[cell] = sample.WithReply(now);
+
+        replied++;
+        replyTotal += delta;
+        replyWorst = Mathf.Max(replyWorst, delta);
+
+        Log.Info($"[LMS] reply cell={Describe(cell)} in={delta * 1000f:0} ms " +
+                 $"at={sample.Speed:0.0} m/s");
+    }
+
+    /// <summary>Everything the cell had is in the world: the end of the whole trip.</summary>
+    public static void Spawned(AbsoluteEntityCell cell)
+    {
+        if (!Enabled || !InFlight.TryGetValue(cell, out Sample sample))
+        {
+            return;
+        }
+
+        InFlight.Remove(cell);
+
+        float total = Time.realtimeSinceStartup - sample.SentAt;
+        float queue = sample.RepliedAt > 0f ? Time.realtimeSinceStartup - sample.RepliedAt : -1f;
+
+        spawned++;
+        spawnTotal += total;
+        spawnWorst = Mathf.Max(spawnWorst, total);
+
+        Log.Info($"[LMS] spawned cell={Describe(cell)} total={total * 1000f:0} ms " +
+                 $"queue={(queue < 0f ? "?" : $"{queue * 1000f:0}")} ms at={sample.Speed:0.0} m/s");
+    }
+
+    /// <summary>
+    /// The client has dropped this cell while a reply was still owed.
+    /// </summary>
+    /// <remarks>
+    /// The late reply then throws <c>OptionalEmptyException&lt;GameObject&gt;</c>. Counted separately
+    /// so it cannot hide in the averages.
+    /// </remarks>
+    public static void Unloaded(AbsoluteEntityCell cell)
+    {
+        if (!Enabled || !InFlight.TryGetValue(cell, out Sample sample))
+        {
+            return;
+        }
+
+        InFlight.Remove(cell);
+        unloadedFirst++;
+
+        float waited = Time.realtimeSinceStartup - sample.SentAt;
+
+        Log.Warn($"[LMS] MISS unloaded-first cell={Describe(cell)} " +
+                 $"waited={waited * 1000f:0} ms at={sample.Speed:0.0} m/s");
+    }
+
+    /// <summary>
+    /// Called once a frame from <c>Terrain.UpdateVisibility</c>: the speed, the give-ups, the summary.
+    /// </summary>
+    /// <remarks>
+    /// Speed is the streaming centre's smoothed movement, so it works in any vehicle or free camera.
+    /// </remarks>
+    public static void Tick(Vector3 streamingCentre)
+    {
+        if (!Enabled)
+        {
+            return;
+        }
+
+        float dt = Time.deltaTime;
+        if (dt > 0f)
+        {
+            float instant = Vector3.Distance(streamingCentre, wasAt) / dt;
+            speed = Mathf.Lerp(speed, instant, Mathf.Clamp01(dt * 4f));
+        }
+
+        wasAt = streamingCentre;
+
+        GiveUp();
+        Summarise();
+    }
+
+    /// <summary>
+    /// Counts cells with no reply within <see cref="GiveUpAfterSeconds"/> as never answered, and
+    /// remembers them in <see cref="GaveUpOn"/> so a later reply counts as late.
+    /// </summary>
+    private static void GiveUp()
+    {
+        float now = Time.realtimeSinceStartup;
+        List<AbsoluteEntityCell> lost = null;
+
+        foreach (KeyValuePair<AbsoluteEntityCell, Sample> waiting in InFlight)
+        {
+            if (now - waiting.Value.SentAt >= GiveUpAfterSeconds)
+            {
+                (lost ??= []).Add(waiting.Key);
+            }
+        }
+
+        if (lost == null)
+        {
+            return;
+        }
+
+        foreach (AbsoluteEntityCell cell in lost)
+        {
+            Sample sample = InFlight[cell];
+            InFlight.Remove(cell);
+            GaveUpOn[cell] = sample.SentAt;
+            neverAnswered++;
+
+            Log.Warn($"[LMS] MISS never-answered cell={Describe(cell)} " +
+                     $"waited={GiveUpAfterSeconds:0}s at={sample.Speed:0.0} m/s");
+        }
+    }
+
+    private static void Summarise()
+    {
+        float now = Time.realtimeSinceStartup;
+        if (now - lastSummaryAt < SummaryEverySeconds)
+        {
+            return;
+        }
+
+        lastSummaryAt = now;
+
+        if (replied == 0 && spawned == 0 && unloadedFirst == 0 && neverAnswered == 0 && late == 0)
+        {
+            return;
+        }
+
+        Log.Info($"[LMS] SUMMARY {SummaryEverySeconds:0}s: " +
+                 $"replies={replied} mean={Mean(replyTotal, replied)} worst={replyWorst * 1000f:0} ms | " +
+                 $"spawned={spawned} mean={Mean(spawnTotal, spawned)} worst={spawnWorst * 1000f:0} ms | " +
+                 $"MISS unloaded-first={unloadedFirst} never-answered={neverAnswered} | " +
+                 $"in flight={InFlight.Count} at={speed:0.0} m/s | " +
+                 $"late={late} worst={lateWorst * 1000f:0} ms");
+
+        replied = 0;
+        replyTotal = 0f;
+        replyWorst = 0f;
+        spawned = 0;
+        spawnTotal = 0f;
+        spawnWorst = 0f;
+        unloadedFirst = 0;
+        neverAnswered = 0;
+        late = 0;
+        lateWorst = 0f;
+    }
+
+    private static string Mean(float total, int count) =>
+        count == 0 ? "-" : $"{total / count * 1000f:0} ms";
+
+    private static string Describe(AbsoluteEntityCell cell) =>
+        $"{cell.BatchId.X},{cell.BatchId.Y},{cell.BatchId.Z}/" +
+        $"{cell.CellId.X},{cell.CellId.Y},{cell.CellId.Z}@L{cell.Level}";
+
+    private readonly struct Sample
+    {
+        public Sample(float sentAt, float speed)
+        {
+            SentAt = sentAt;
+            RepliedAt = 0f;
+            Speed = speed;
+        }
+
+        private Sample(float sentAt, float repliedAt, float speed)
+        {
+            SentAt = sentAt;
+            RepliedAt = repliedAt;
+            Speed = speed;
+        }
+
+        public float SentAt { get; }
+
+        public float RepliedAt { get; }
+
+        /// <summary>How fast the streaming centre was moving when the request went out.</summary>
+        public float Speed { get; }
+
+        public Sample WithReply(float at) => new(SentAt, at, Speed);
+    }
+}
