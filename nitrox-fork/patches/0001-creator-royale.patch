diff --git a/Nitrox.Model/Networking/PacketFrame.cs b/Nitrox.Model/Networking/PacketFrame.cs
new file mode 100644
index 0000000..645c898
--- /dev/null
+++ b/Nitrox.Model/Networking/PacketFrame.cs
@@ -0,0 +1,109 @@
+using System.Buffers;
+using System.IO;
+using System.IO.Compression;
+using LiteNetLib.Utils;
+using Nitrox.Model.Packets;
+
+namespace Nitrox.Model.Networking;
+
+/// <summary>
+///     How both ends put a packet on the wire: its length, then the packet -- deflated when that saves
+///     datagrams.
+/// </summary>
+/// <remarks>
+///     LiteNetLib keeps at most 64 reliable datagrams of 1,432 bytes in flight per channel (~90 KB per
+///     round trip), so large packets such as a join's <c>SpawnEntities</c> are deflated to save round trips.
+///     <para>
+///     A negative length marks a deflated packet and is followed by the inflated length. A packet that
+///     fits in one datagram is framed exactly as stock, so the version handshake still reads across builds.
+///     </para>
+/// </remarks>
+public static class PacketFrame
+{
+    /// <summary>Below this a packet is one datagram already, and deflating it would save bytes but no round trips.</summary>
+    private const int DeflateFrom = 1024;
+
+    /// <summary>The largest packet a deflated frame may claim to inflate to, so a forged frame cannot ask for gigabytes.</summary>
+    private const int LargestPacket = 64 * 1024 * 1024;
+
+    public static void Write(NetDataWriter writer, Packet packet)
+    {
+        byte[] plain = packet.Serialize();
+        writer.Reset();
+
+        if (plain.Length >= DeflateFrom)
+        {
+            byte[] deflated = Deflate(plain);
+            if (deflated.Length < plain.Length)
+            {
+                writer.Put(-deflated.Length);
+                writer.Put(plain.Length);
+                writer.Put(deflated);
+                return;
+            }
+        }
+
+        writer.Put(plain.Length);
+        writer.Put(plain);
+    }
+
+    public static Packet Read(NetDataReader reader)
+    {
+        int length = reader.GetInt();
+        int plainLength = length < 0 ? reader.GetInt() : length;
+        if (plainLength is < 0 or > LargestPacket)
+        {
+            throw new InvalidDataException($"A packet frame claims {plainLength} bytes");
+        }
+
+        byte[] plain = ArrayPool<byte>.Shared.Rent(plainLength);
+        try
+        {
+            if (length < 0)
+            {
+                Inflate(reader, -length, plain, plainLength);
+            }
+            else
+            {
+                reader.GetBytes(plain, plainLength);
+            }
+
+            return Packet.Deserialize(plain);
+        }
+        finally
+        {
+            ArrayPool<byte>.Shared.Return(plain, true);
+        }
+    }
+
+    private static byte[] Deflate(byte[] plain)
+    {
+        using MemoryStream deflated = new();
+        using (DeflateStream deflate = new(deflated, CompressionLevel.Optimal, true))
+        {
+            deflate.Write(plain, 0, plain.Length);
+        }
+
+        return deflated.ToArray();
+    }
+
+    private static void Inflate(NetDataReader reader, int deflatedLength, byte[] plain, int plainLength)
+    {
+        using (DeflateStream inflate = new(new MemoryStream(reader.RawData, reader.Position, deflatedLength), CompressionMode.Decompress))
+        {
+            int read = 0;
+            while (read < plainLength)
+            {
+                int got = inflate.Read(plain, read, plainLength - read);
+                if (got == 0)
+                {
+                    throw new InvalidDataException($"A deflated packet ended at {read} of {plainLength} bytes");
+                }
+
+                read += got;
+            }
+        }
+
+        reader.SkipBytes(deflatedLength);
+    }
+}
