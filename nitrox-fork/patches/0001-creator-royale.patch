diff --git a/Nitrox.Server.Subnautica/Models/GameLogic/LmsGameMode.cs b/Nitrox.Server.Subnautica/Models/GameLogic/LmsGameMode.cs
new file mode 100644
index 0000000..fe56d96
--- /dev/null
+++ b/Nitrox.Server.Subnautica/Models/GameLogic/LmsGameMode.cs
@@ -0,0 +1,67 @@
+using System.Collections.Generic;
+using Nitrox.Model.Server;
+using Nitrox.Model.Subnautica.Packets;
+using Nitrox.Model.Subnautica.Tournament;
+
+namespace Nitrox.Server.Subnautica.Models.GameLogic;
+
+/// <summary>
+///     Lets the tournament mod read players' game modes and force a player back into survival.
+/// </summary>
+/// <remarks>
+///     Correcting mirrors <c>GameModeCommand</c>: set <c>player.GameMode</c> so it persists, then
+///     broadcast <c>GameModeChanged.ForPlayer</c>, or the player stays invincible until they reconnect.
+/// </remarks>
+internal sealed class LmsGameMode : ILmsGameMode
+{
+    private readonly PlayerManager playerManager;
+
+    internal LmsGameMode(PlayerManager playerManager)
+    {
+        this.playerManager = playerManager;
+    }
+
+    public IReadOnlyList<LmsPlayerMode> Modes
+    {
+        get
+        {
+            List<LmsPlayerMode> readings = new();
+
+            foreach (Player player in playerManager.GetAllPlayers())
+            {
+                // ToString(): the mod cannot reference this enum, and the audit log uses its spelling.
+                readings.Add(new LmsPlayerMode(player.Id, player.Name, player.GameMode.ToString()));
+            }
+
+            return readings;
+        }
+    }
+
+    public bool MakeSurvival(ushort playerId)
+    {
+        foreach (Player player in playerManager.GetAllPlayers())
+        {
+            if (player.Id != playerId)
+            {
+                continue;
+            }
+
+            player.GameMode = NitroxGameMode.SURVIVAL;
+
+            // PlayerContext.GameMode is what other clients build this player from (join broadcast,
+            // InitialPlayerSync), and is otherwise never updated. The packet below cannot cover a
+            // client that has no RemotePlayer for this id yet, and a stale CREATIVE there makes the
+            // player unattackable on that machine.
+            if (player.PlayerContext != null)
+            {
+                player.PlayerContext.GameMode = NitroxGameMode.SURVIVAL;
+            }
+
+            playerManager.SendPacketToAllPlayers(
+                GameModeChanged.ForPlayer(playerId, NitroxGameMode.SURVIVAL));
+            return true;
+        }
+
+        return false;
+    }
+}
diff --git a/Nitrox.Server.Subnautica/Models/GameLogic/LmsPodSeating.cs b/Nitrox.Server.Subnautica/Models/GameLogic/LmsPodSeating.cs
new file mode 100644
index 0000000..fd2857d
--- /dev/null
+++ b/Nitrox.Server.Subnautica/Models/GameLogic/LmsPodSeating.cs
@@ -0,0 +1,159 @@
+using System.Collections.Generic;
+using Nitrox.Model.DataStructures;
+using Nitrox.Model.DataStructures.GameLogic;
+using Nitrox.Model.DataStructures.Unity;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic.Entities;
+using Nitrox.Model.Subnautica.Packets;
+using Nitrox.Model.Subnautica.Tournament;
+using Nitrox.Server.Subnautica.Models.Serialization.World;
+
+namespace Nitrox.Server.Subnautica.Models.GameLogic;
+
+/// <summary>
+///     Lets the tournament mod read escape pods, make new ones, seat players in them and remove them.
+/// </summary>
+internal sealed class LmsPodSeating : ILmsPodSeating
+{
+    private readonly World world;
+    private readonly PlayerManager playerManager;
+
+    internal LmsPodSeating(World world, PlayerManager playerManager)
+    {
+        this.world = world;
+        this.playerManager = playerManager;
+    }
+
+    public IReadOnlyList<LmsPod> Pods
+    {
+        get
+        {
+            List<EscapePodEntity> pods = world.EntityRegistry.GetEntities<EscapePodEntity>();
+            List<LmsPod> readings = new(pods.Count);
+
+            foreach (EscapePodEntity pod in pods)
+            {
+                NitroxVector3 where = pod.Transform.Position;
+
+                readings.Add(new LmsPod(pod.Id.ToString(), where.X, where.Y, where.Z,
+                    pod.Players.ToArray(), StowedIn(pod)));
+            }
+
+            return readings;
+        }
+    }
+
+    /// <summary>
+    ///     Counts <see cref="InventoryItemEntity"/>s anywhere in a pod's hierarchy (locker, medical
+    ///     cabinet, ...): what clearing it would destroy. The built-in fittings are not counted.
+    /// </summary>
+    private static int StowedIn(Entity pod)
+    {
+        int stowed = 0;
+
+        foreach (Entity child in pod.ChildEntities)
+        {
+            if (child is InventoryItemEntity)
+            {
+                stowed++;
+            }
+
+            stowed += StowedIn(child);
+        }
+
+        return stowed;
+    }
+
+    public IReadOnlyList<NitroxVector3> StartPoints => world.EscapePodManager.StartPoints;
+
+    public string MakePod(NitroxVector3 where, ushort ownerId)
+    {
+        EscapePodEntity made = world.EscapePodManager.MakePodAt(where);
+
+        if (made == null)
+        {
+            return null;
+        }
+
+        // Assign before broadcasting: EscapePodEntitySpawner.IsOurs treats a pod with no players as
+        // the local player's, so every client would move its own EscapePod.main onto it.
+        world.EscapePodManager.SeatPlayerInPod(ownerId, made);
+
+        // Same packet a real join broadcasts; every client but the owner draws it as a wreck.
+        playerManager.SendPacketToAllPlayers(new SpawnEntities(made));
+
+        return made.Id.ToString();
+    }
+
+    public bool Seat(ushort playerId, string podId)
+    {
+        EscapePodEntity pod = PodWithId(podId);
+
+        if (pod == null)
+        {
+            return false;
+        }
+
+        Player player = Connected(playerId);
+
+        if (player == null)
+        {
+            // Disconnected since the roster was read.
+            return false;
+        }
+
+        world.EscapePodManager.SeatPlayerInPod(playerId, pod);
+
+        // SubRootId is where a rejoin places the player; the teleport moves them now.
+        player.SubRootId = pod.Id;
+        player.Teleport(pod.Transform.Position, Optional.Of(pod.Id));
+
+        return true;
+    }
+
+    public bool RemovePod(string id)
+    {
+        EscapePodEntity pod = PodWithId(id);
+
+        if (pod == null)
+        {
+            return false;
+        }
+
+        // Forget first, so the next join is never assigned to the removed pod.
+        world.EscapePodManager.ForgetPod(pod.Id);
+        world.WorldEntityManager.RemoveGlobalRootEntity(pod.Id);
+
+        // Clients remove the wreck. A client whose own pod this was no longer has the id, because
+        // EscapePodEntitySpawner re-tags EscapePod.main when it moves it.
+        playerManager.SendPacketToAllPlayers(new EntityDestroyed(pod.Id));
+
+        return true;
+    }
+
+    private EscapePodEntity PodWithId(string id)
+    {
+        foreach (EscapePodEntity pod in world.EntityRegistry.GetEntities<EscapePodEntity>())
+        {
+            if (pod.Id.ToString() == id)
+            {
+                return pod;
+            }
+        }
+
+        return null;
+    }
+
+    private Player Connected(ushort playerId)
+    {
+        foreach (Player player in playerManager.GetConnectedPlayers())
+        {
+            if (player.Id == playerId)
+            {
+                return player;
+            }
+        }
+
+        return null;
+    }
+}
