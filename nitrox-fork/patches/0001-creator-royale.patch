diff --git a/Nitrox.Model.Subnautica/Tournament/LmsMatchStateRelay.cs b/Nitrox.Model.Subnautica/Tournament/LmsMatchStateRelay.cs
new file mode 100644
index 0000000..6ae54c0
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/LmsMatchStateRelay.cs
@@ -0,0 +1,22 @@
+using System;
+using Nitrox.Model.Subnautica.Packets;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     Where a <see cref="LmsMatchState"/> goes after Nitrox has received it.
+/// </summary>
+/// <remarks>
+///     Packet processors must live in <c>NitroxClient</c>, so the fork publishes and the mod
+///     subscribes. Raised on Nitrox's packet pump in <c>Multiplayer.Update</c>, i.e. Unity's main thread.
+/// </remarks>
+public static class LmsMatchStateRelay
+{
+    /// <summary>Raised once per packet. Nothing is subscribed when the mod is absent.</summary>
+    public static event Action<string>? Received;
+
+    public static void Publish(string state)
+    {
+        Received?.Invoke(state);
+    }
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/LmsNetwork.cs b/Nitrox.Model.Subnautica/Tournament/LmsNetwork.cs
new file mode 100644
index 0000000..88c49da
--- /dev/null
+++ b/Nitrox.Model.Subnautica/Tournament/LmsNetwork.cs
@@ -0,0 +1,35 @@
+using System;
+
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     What the tournament client can find out about its own connection.
+/// </summary>
+/// <remarks>
+///     Filled in by <c>NitroxPatcher.LmsHook</c> so the mod never references <c>NitroxClient</c>.
+///     <c>LatencyUpdateCallback</c> carries <c>NetPeer.RemoteTimeDelta</c>, a clock offset, not a
+///     ping; the round trip is <c>NetPeer.Ping</c>. Null until the hook sets it.
+/// </remarks>
+public static class LmsNetwork
+{
+    /// <summary>
+    ///     The round trip to the server in milliseconds, or a negative number when there is none.
+    /// </summary>
+    /// <remarks>
+    ///     A function because the connection belongs to Nitrox's session scope and changes on rejoin.
+    /// </remarks>
+    public static Func<int> Ping { get; set; }
+
+    /// <summary>
+    ///     The round trip in milliseconds, or -1 when nothing can say.
+    /// </summary>
+    /// <remarks>
+    ///     -1 rather than 0, because 0 is a real reading on a local server.
+    /// </remarks>
+    public static int PingMs()
+    {
+        Func<int> ping = Ping;
+
+        return ping == null ? -1 : ping();
+    }
+}
diff --git a/Nitrox.Model.Subnautica/Tournament/LmsPlayerMode.cs b/Nitrox.Model.Subnautica/Tournament/LmsPlayerMode.cs
