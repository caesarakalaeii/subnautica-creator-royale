@@ -0,0 +1,239 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using Nitrox.Model.Subnautica.DataStructures.GameLogic;
+using Nitrox.Model.Subnautica.Tournament;
+using Nitrox.Server.Subnautica.Models.Serialization.World;
+using Timer = System.Timers.Timer;
+
+namespace Nitrox.Server.Subnautica.Models.GameLogic;
+
+/// <summary>
+///     Runs the tournament if the mod's <c>Lms.Server.dll</c> is installed beside the server.
+/// </summary>
+/// <remarks>
+///     The mod is loaded by name (like <c>NitroxPatcher.LmsHook</c> on the client), so the fork
+///     references none of its assemblies; when it is absent or broken the server runs as stock Nitrox.
+///     The match clock is <see cref="TimeKeeper"/>'s world time, which every client also reads and
+///     which stops while the server is paused.
+/// </remarks>
+public class LmsTournament
+{
+    /// <summary>The mod's server assembly, loaded by name.</summary>
+    private const string ModAssembly = "Lms.Server.dll";
+    private const string ModEntryPoint = "Lms.Server.LmsServerMod";
+
+    /// <summary>
+    ///     How often the match ticks; sets how smoothly the caster feed and follow camera move.
+    /// </summary>
+    /// <remarks>
+    ///     Must divide one second so the booth's one-second push lands on a tick. The mod's
+    ///     <c>CasterTrack.MaxLeadSeconds</c> must equal this; nothing checks it at build time.
+    /// </remarks>
+    private const double TickIntervalSeconds = 0.25;
+
+    private readonly PlayerManager playerManager;
+    private readonly TimeKeeper timeKeeper;
+    private readonly World world;
+    private readonly Timer timer;
+
+    private ILmsTournamentHost? host;
+    private bool looked;
+
+    public LmsTournament(PlayerManager playerManager, TimeKeeper timeKeeper, World world)
+    {
+        this.playerManager = playerManager;
+        this.timeKeeper = timeKeeper;
+        this.world = world;
+
+        timer = new Timer(TimeSpan.FromSeconds(TickIntervalSeconds).TotalMilliseconds) { AutoReset = true };
+        timer.Elapsed += delegate { Tick(); };
+    }
+
+    /// <summary>Whether a tournament is running on this server at all.</summary>
+    public bool IsLoaded => host != null;
+
+    private TimeSpan WorldNow => TimeSpan.FromSeconds(timeKeeper.ElapsedSeconds);
+
+    /// <summary>Loads the mod's server half and starts driving the match.</summary>
+    public void Start()
+    {
+        if (host != null)
+        {
+            return;
+        }
+
+        // Wire the seams before loading the mod: it may use them from its first tick or command.
+        LmsRoster.Source = Roster;
+        LmsPods.Seating = new LmsPodSeating(world, playerManager);
+        LmsGameModes.Modes = new LmsGameMode(playerManager);
+
+        // Also before loading, so a hit during the load is not applied by Nitrox's own PvP path.
+        LmsCombat.TournamentOwnsPvP = true;
+
+        host = Load();
+        looked = true;
+
+        if (host == null)
+        {
+            LmsRoster.Source = null;
+            LmsPods.Seating = null;
+            LmsGameModes.Modes = null;
+            LmsCombat.TournamentOwnsPvP = false;
+            return;
+        }
+
+        timer.Start();
+    }
+
+    public void Stop()
+    {
+        timer.Stop();
+        LmsRoster.Source = null;
+        LmsPods.Seating = null;
+        LmsGameModes.Modes = null;
+        LmsCombat.TournamentOwnsPvP = false;
+    }
+
+    /// <summary>Runs one <c>lms</c> verb and returns the line to say back.</summary>
+    public string Command(string? verb)
+    {
+        if (host == null)
+        {
+            // Distinguish "not installed" from "still starting".
+            return looked
+                ? $"No tournament is loaded on this server: {ModAssembly} is not installed beside it."
+                : "The server has not finished starting; ask again in a moment.";
+        }
+
+        try
+        {
+            return host.Command(verb, WorldNow);
+        }
+        catch (Exception ex)
+        {
+            Log.Error(ex, "The tournament refused a command");
+            return "The tournament failed to run that command; the server log says why.";
+        }
+    }
+
+    /// <summary>Tells one player what the zone is doing, once they can be told anything.</summary>
+    public void Greet(ushort playerId)
+    {
+        if (host == null)
+        {
+            return;
+        }
+
+        try
+        {
+            host.Greet(playerId, WorldNow);
+        }
+        catch (Exception ex)
+        {
+            Log.Error(ex, "The tournament failed to greet a joining player");
+        }
+    }
+
+    /// <summary>
+    ///     Advances the match. A throwing tick unloads the tournament for the session and logs once.
+    /// </summary>
+    /// <remarks>
+    ///     The seams stay wired, including <see cref="LmsCombat.TournamentOwnsPvP"/>, so stock PvP
+    ///     does not silently resume mid-round.
+    /// </remarks>
+    private void Tick()
+    {
+        try
+        {
+            host?.Tick(WorldNow);
+        }
+        catch (Exception ex)
+        {
+            timer.Stop();
+            host = null;
+            Log.Error(ex, "The tournament threw while running the match; it is stopped for this session");
+        }
+    }
+
+    private ILmsTournamentHost? Load()
+    {
+        string directory = AppContext.BaseDirectory;
+        string[] candidates = { Path.Combine(directory, "lib", ModAssembly), Path.Combine(directory, ModAssembly) };
+
+        foreach (string candidate in candidates)
+        {
+            if (!File.Exists(candidate))
+            {
+                continue;
+            }
+
+            try
+            {
+                Type? entry = Assembly.LoadFrom(candidate).GetType(ModEntryPoint);
+                MethodInfo? initialize = entry?.GetMethod("Initialize", BindingFlags.Public | BindingFlags.Static);
+                if (initialize == null)
+                {
+                    Log.Warn($"[LMS] {candidate} has no {ModEntryPoint}.Initialize; running as stock Nitrox.");
+                    return null;
+                }
+
+                object? loaded = initialize.Invoke(null,
+                    new object[] { directory, (Action<string>)Broadcast, (Action<ushort, string>)SendTo });
+
+                if (loaded is ILmsTournamentHost tournament)
+                {
+                    Log.Info($"[LMS] tournament host loaded from '{candidate}'");
+                    return tournament;
+                }
+
+                Log.Warn($"[LMS] {ModEntryPoint}.Initialize declined to start a tournament; running as stock Nitrox.");
+                return null;
+            }
+            catch (Exception ex)
+            {
+                Log.Error(ex, $"[LMS] {candidate} failed to load; running as stock Nitrox");
+                return null;
+            }
+        }
+
+        Log.Info($"[LMS] no {ModAssembly} beside the server; running as stock Nitrox. Looked in: {string.Join(", ", candidates)}");
+
+        return null;
+    }
+
+    /// <summary>Every connected player, read on demand for the mod's casting-booth feed.</summary>
+    /// <remarks>
+    ///     Stats are zero until a client sends its first <c>PlayerStats</c>; the row is still included.
+    /// </remarks>
+    private IReadOnlyList<LmsPlayerReading> Roster()
+    {
+        List<Player> players = playerManager.GetConnectedPlayers();
+        List<LmsPlayerReading> roster = new List<LmsPlayerReading>(players.Count);
+
+        foreach (Player player in players)
+        {
+            PlayerStatsData stats = player.Stats;
+
+            roster.Add(new LmsPlayerReading(player.Id, player.Name, !player.IsPermaDeath,
+                player.Position.X, player.Position.Y, player.Position.Z,
+                stats?.Health ?? 0, stats?.Oxygen ?? 0, stats?.Food ?? 0, stats?.Water ?? 0));
+        }
+
+        return roster;
+    }
+
+    private void Broadcast(string state)
+    {
+        playerManager.SendPacketToAllPlayers(new LmsMatchState(state));
+    }
+
+    private void SendTo(ushort playerId, string state)
+    {
+        if (playerManager.TryGetPlayerById(playerId, out Player player))
+        {
+            player.SendPacket(new LmsMatchState(state));
+        }
+    }
+}
