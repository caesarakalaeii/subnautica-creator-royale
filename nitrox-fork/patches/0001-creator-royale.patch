@@ -0,0 +1,28 @@
+namespace Nitrox.Model.Subnautica.Tournament;
+
+/// <summary>
+///     The game mode one connected player is actually in.
+/// </summary>
+/// <remarks>
+///     Flat so the mod's Core, which cannot see Nitrox, can hold it. The mode is the server's own
+///     spelling of <see cref="Nitrox.Model.DataStructures.GameLogic.NitroxGameMode"/> so new modes
+///     still read correctly.
+/// </remarks>
+public readonly struct LmsPlayerMode
+{
+    public LmsPlayerMode(ushort id, string name, string mode)
+    {
+        Id = id;
+        Name = name;
+        Mode = mode;
+    }
+
+    /// <summary>The server's own player id, which is how a correction is addressed.</summary>
+    public ushort Id { get; }
+
+    /// <summary>The name the tournament knows them by.</summary>
+    public string Name { get; }
+
+    /// <summary>The mode the server holds for them, in the server's own spelling.</summary>
+    public string Mode { get; }
+}
